# jupiter-mcp-server — example configuration
# Copy the values you need into your MCP client's server "env" block
# (Claude Desktop, Claude Code, Hermes, ...). The server does not read a .env file itself.
# NEVER commit a filled-in copy of this file or any file containing a real key.

# Required: Jupiter API key (https://developers.jup.ag)
JUPITER_API_KEY=

# Required: Solana RPC endpoint. A paid provider is strongly recommended.
# HELIUS_RPC_URL is also accepted as a fallback.
SOLANA_RPC_URL=

# Wallet key: set ONE of the two below.
# Option A (preferred): path to a keypair file, base58 or Solana CLI id.json format.
# Takes precedence over SOLANA_PRIVATE_KEY; a missing or invalid file is an error.
SOLANA_KEYPAIR_PATH=
# Option B: the secret key itself, as base58 or a JSON array of 64 numbers.
SOLANA_PRIVATE_KEY=

# Optional limits. Off when unset or empty.
# Refuse perps opens above this leverage, e.g. 5
MAX_LEVERAGE=
# Refuse perps opens above this slippage in basis points, e.g. 300. Never applies to closes.
MAX_SLIPPAGE_BPS=